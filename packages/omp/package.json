{
  "name": "@gendigital/sage-omp",
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public"
  },
  "description": "Sage connector for Oh My Pi — in-process hook for agent tool call security",
  "homepage": "https://github.com/gendigitalinc/sage",
  "repository": {
    "type": "git",
    "url": "https://github.com/gendigitalinc/sage.git",
    "directory": "packages/omp"
  },
  "bugs": {
    "url": "https://github.com/gendigitalinc/sage/issues"
  },
  "version": "0.15.0",
  "type": "module",
  "main": "./dist/index.cjs",
  "exports": {
    ".": "./dist/index.cjs"
  },
  "files": [
    "dist/**",
    "resources/**",
    "package.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "pnpm run clean && node esbuild.config.mjs",
    "clean": "node ../../scripts/clean.mjs dist tsconfig.tsbuildinfo",
    "prepack": "node ../../scripts/check-workspace-refs.mjs && node ../../scripts/sync-connector-assets.mjs",
    "postpack": "node ../../scripts/clean.mjs resources",
    "test": "vitest run"
  },
  "optionalDependencies": {
    "koffi": "^2.9.0"
  },
  "devDependencies": {
    "@gendigital/sage-core": "workspace:*",
    "@gendigital/sage-hook-host": "workspace:*",
    "@types/node": "^22.0.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.9.0",
    "vitest": "^4.0.0"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "security",
    "adr",
    "agent-security",
    "oh-my-pi",
    "omp",
    "hook",
    "safety",
    "malware-detection"
  ]
}
